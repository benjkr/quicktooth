<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 for the WinRT Bluetooth LE advertisement API (AirPods battery). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/quicktooth.ico</ApplicationIcon>
    <RootNamespace>QuickTooth</RootNamespace>
    <AssemblyName>QuickTooth</AssemblyName>
    <AssemblyTitle>QuickTooth</AssemblyTitle>
    <Product>QuickTooth</Product>
    <Version>1.1.0</Version>

    <!-- Published as one native exe (Native AOT): no .NET runtime to install or bundle. COM goes
         through source-generated wrappers and JSON through a source-generated context, so the
         AOT/trim analyzers must stay at zero warnings. Shared settings (nullable, runtime patch
         pin) are in ../Directory.Build.props and .targets. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Size</OptimizationPreference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon drawing, tray behaviour, settings: shared with the browser simulator (QuickTooth.Web). -->
    <ProjectReference Include="..\QuickTooth.Core\QuickTooth.Core.csproj" />
  </ItemGroup>

</Project>
