{
  "name": "low-battery",
  "description": "the orange dot shows while the emptier bud is at 20% or less, not while charging, rippling when it appears and every 3 s; it goes when the buds recharge or disconnect",
  "options": { "profile": "fast" },
  "region": "icon",
  "zoom": 8,
  "steps": [
    { "bt": ["setBattery", "AirPods Pro", { "left": 20, "right": 30 }] },
    { "click": "icon" },
    { "waitFor": "s.app.pending === null", "timeout": 5000 },
    { "waitFor": "s.app.icon.kind === 'static'", "timeout": 2000 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" }, "app.battery": null } },
    { "waitFor": "s.app.anim === 'LowBattery'", "timeout": 15000, "label": "first ripple when the dot appears" },
    { "expect": { "app.tooltip": "AirPods Pro — Connected · 20%" } },
    { "waitFor": "s.app.anim === null", "timeout": 1000 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected", "lowBattery": true } } },
    { "move": "200,200" },
    { "shot": "low-battery" },
    { "waitFor": "s.app.anim === 'LowBattery'", "timeout": 3000, "label": "the next ripple 3 s after the first" },
    { "wait": 300 },
    { "shot": "ripple" },
    { "waitFor": "s.app.anim === null", "timeout": 1000 },

    { "bt": ["setBattery", "AirPods Pro", { "left": 30, "right": 30 }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.battery.text === '30%' && s.app.anim === null", "timeout": 15000 },
    { "expect": { "app.tooltip": "AirPods Pro — Connected · 30%", "app.icon": { "kind": "static", "state": "connected" } } },
    { "waitFor": "!s.app.timers.some((t) => t.name === 'TIMER_LOWBATTERY')", "timeout": 100, "label": "no more ripples above 20%" },

    { "bt": ["setBattery", "AirPods Pro", { "left": 10, "right": 10, "budsCharging": true }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.battery.text === '10% charging'", "timeout": 15000 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" }, "app.anim": null } },

    { "bt": ["setBattery", "AirPods Pro", { "left": 10, "right": 10, "budsCharging": false }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.anim === 'LowBattery'", "timeout": 15000 },
    { "waitFor": "s.app.anim === null", "timeout": 1000 },
    { "bt": ["externalDisconnect", "AirPods Pro"] },
    { "waitFor": "s.app.tooltip === 'AirPods Pro — Not connected'", "timeout": 10000 },
    { "expect": { "app.icon": { "kind": "static", "state": "disconnected" } } },
    { "waitFor": "!s.app.timers.some((t) => t.name === 'TIMER_LOWBATTERY')", "timeout": 100, "label": "no ripples once disconnected" }
  ]
}
