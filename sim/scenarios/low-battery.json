{
  "name": "low-battery",
  "description": "the orange dot shows while the emptier bud is at 20% or less, not while charging, and goes when the buds recharge or disconnect",
  "options": { "profile": "fast" },
  "region": "icon",
  "zoom": 8,
  "steps": [
    { "bt": ["setBattery", "AirPods Pro", { "left": 20, "right": 30 }] },
    { "click": "icon" },
    { "waitFor": "s.app.pending === null", "timeout": 5000 },
    { "waitFor": "s.app.icon.kind === 'static'", "timeout": 2000 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" }, "app.battery": null } },
    { "waitFor": "s.app.battery !== null", "timeout": 15000 },
    { "expect": { "app.tooltip": "AirPods Pro — Connected · 20%", "app.icon.lowBattery": true } },
    { "move": "200,200" },
    { "wait": 500 },
    { "shot": "low-battery" },
    { "bt": ["setBattery", "AirPods Pro", { "left": 30, "right": 30 }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.battery.text === '30%'", "timeout": 15000 },
    { "expect": { "app.tooltip": "AirPods Pro — Connected · 30%", "app.icon": { "kind": "static", "state": "connected" } } },
    { "bt": ["setBattery", "AirPods Pro", { "left": 10, "right": 10, "budsCharging": true }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.battery.text === '10% charging'", "timeout": 15000 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" } } },
    { "bt": ["setBattery", "AirPods Pro", { "left": 10, "right": 10, "budsCharging": false }] },
    { "wait": 61000 },
    { "rightClick": "icon" },
    { "key": "Escape" },
    { "waitFor": "s.app.icon.lowBattery === true", "timeout": 15000 },
    { "bt": ["externalDisconnect", "AirPods Pro"] },
    { "waitFor": "s.app.tooltip === 'AirPods Pro — Not connected'", "timeout": 10000 },
    { "expect": { "app.icon": { "kind": "static", "state": "disconnected" } } }
  ]
}
